# Copie documentée de .env (le vrai fichier est généré par `make setup`).
# Clé secrète Django : longue chaîne aléatoire, propre à chaque installation.
DJANGO_SECRET_KEY=
# 1 en développement, 0 (ou absent) en classe / production.
DJANGO_DEBUG=1
# Noms d'hôte autorisés, séparés par des virgules.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
